# ratcount · 环境变量示例（复制为 .env.local 使用）
# ratcount · Environment variable example (copy it to .env.local)
# ==================================================
# 数据库连接（双部署唯一开关）：
#   以 file: 开头 = 本地 SQLite（默认，零配置）
#   libsql:// 或 https:// = Turso 云端（此时必须配置下方 TURSO_AUTH_TOKEN）
# Database connection (the single switch for dual deployment):
#   `file:` prefix            → local SQLite (default, zero config)
#   `libsql://` or `https://` → Turso cloud (then TURSO_AUTH_TOKEN below is required)
DATABASE_URL=file:./data/ratcount.db

# Turso 云端令牌（DATABASE_URL 为 libsql:// 或 https:// 时必填）
# Turso cloud auth token (required when DATABASE_URL is libsql:// or https://)
TURSO_AUTH_TOKEN=

# 认证密钥（生产环境务必替换为强随机值）
# Auth secret (replace with a strong random value in production)
AUTH_SECRET=change-me-to-a-long-random-string

# 数据库健壮性（可选，均带默认值；可按需覆盖）
# DB robustness (all optional with defaults; override when needed)
# 驱动层并发上限（最接近“连接池”的杠杆）/ Driver-level concurrency cap (closest thing to a pool)
DB_CONCURRENCY=20
# 单条语句软超时（毫秒）/ Per-statement soft timeout (ms)
DB_STATEMENT_TIMEOUT_MS=5000
# 瞬时错误最大重试次数 / Max retries for transient errors
DB_MAX_RETRIES=3
# 重试基础退避（毫秒，指数增长）/ Retry base backoff (ms, exponential)
DB_RETRY_BASE_DELAY_MS=200

# 应用默认名（仅作兜底；后台「应用名称」设置优先）/ App default name (fallback only; admin "App Name" setting wins)
APP_NAME=ratcount

# 运行环境（可选；代码默认 production，部署生产环境请设为 production，此时 env.ts 会严格校验必填项）/ Node environment (optional; code default is production, set production for deploy where env.ts strictly validates required vars)
NODE_ENV=production

# ==================================================
# 审计日志定时清理模式（由 instrumentation.ts 自动判定，这里仅用于覆盖默认值）
# Audit log cleanup mode (auto-detected by instrumentation.ts; these only override the default)
#   - 默认：本地/自托管（VERCEL 未设）走进程内 setInterval 每日清理；Vercel（VERCEL=1）走 Vercel Cron
#   - 设为 cron  → 强制走 Vercel Cron（vercel.json 定时调 /api/cron/cleanup-audit），不启动本地定时器
#   - 设为 local → 强制走进程内定时器（即使部署在 Vercel，也用本地定时器而非 Cron）
#   Default: self-host/local (no VERCEL) uses in-process setInterval; Vercel (VERCEL=1) uses Vercel Cron
#   cron  → force Vercel Cron (vercel.json → /api/cron/cleanup-audit), no local timer
#   local → force in-process timer (even on Vercel)
AUDIT_CLEANUP_MODE=

# Vercel Cron 调用密钥（部署到 Vercel 时必填；未配置则端点等同开放，存在被随意触发风险）
# Vercel Cron auth secret (REQUIRED on Vercel; without it the cron endpoint is effectively open)
# 配置后 Vercel 会自动在请求头附带 Authorization: Bearer <CRON_SECRET>
# Once set, Vercel auto-sends `Authorization: Bearer <CRON_SECRET>` on cron requests
CRON_SECRET=

# 部署模式（可选，一般无需手填）
#   - 桌面端：由 Electron 主进程强制注入 "desktop"（见 electron/main.ts 启动子进程时的环境变量）
#   - 网页 / 自托管：留空即可，或显式设为 "server"（代码仅识别 server / desktop 两值，web 不被识别）
# Deploy mode (optional, usually leave unset):
#   - desktop: injected by Electron main as "desktop" when spawning the local server
#   - web / self-host: leave empty or set "server" (code only recognizes server / desktop; "web" is NOT valid)
NEXT_PUBLIC_DEPLOY_MODE=server
