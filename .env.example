# ratcount · 环境变量示例（复制为 .env.local 使用）
# ==================================================
# 数据模式：file = 本地 SQLite（默认，零配置）；libsql = Turso 云端
# 双部署核心：只需切换一个环境变量
DATABASE_MODE=file

# 本地 SQLite 文件路径（DATABASE_MODE=file 时使用）
DATABASE_URL=file:./data/ratcount.db

# 数据库健壮性（可选，均带默认值；可按需覆盖）
# 驱动层并发上限（最接近“连接池”的杠杆）
DB_CONCURRENCY=20
# 单条语句软超时（毫秒）
DB_STATEMENT_TIMEOUT_MS=5000
# 瞬时错误最大重试次数
DB_MAX_RETRIES=3
# 重试基础退避（毫秒，指数增长）
DB_RETRY_BASE_DELAY_MS=200

# Turso 云端（DATABASE_MODE=libsql 时使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 认证密钥（生产环境务必替换为强随机值）
AUTH_SECRET=change-me-to-a-long-random-string

# 应用展示名（对应全局设置 app_name）
NEXT_PUBLIC_APP_NAME=ratcount
