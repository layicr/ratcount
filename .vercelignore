# ===== ratcount · Vercel 部署忽略清单 / Vercel deploy ignore =====
# 目的：缩减上传体积（不影响 .next 产物；构建只依赖 app/lib/db/i18n/messages 等）
# Purpose: shrink the uploaded source (no impact on the .next output; the build only needs app/lib/db/i18n/messages etc.)

# 单元测试 / 端到端（不打包、不执行；本地保留）
# Unit tests / E2E (not bundled or run on Vercel; kept locally)
test/
e2e/
playwright.config.ts
playwright-report/
test-results/

# 本地调试 / 临时产物（手动排查用，部署无需）
# Local debug / temp artifacts (for manual debugging only)
temp/
temp-debug.mjs
temp-debug.ts

# 文档目录（仅仓库内说明，非构建所需）
# Docs folder (repo notes only, not needed by the build)
doc/

# 本地环境文件（密钥一律走 Vercel 控制台，不入库）
# Local env files (secrets live in the Vercel dashboard, never committed)
.env
.env.local
.env.*.local

# 依赖与缓存（Vercel 自会重装 / 生成）
# Dependencies & caches (Vercel reinstalls / regenerates them)
node_modules/
.next/