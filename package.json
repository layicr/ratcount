{
  "name": "ratcount",
  "version": "0.2.0",
  "private": true,
  "main": "dist/main.js",
  "description": "ratcount",
  "scripts": {
    "dev": "next dev --turbopack --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push && tsx db/init/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "test": "tsx --test \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "build:desktop:next": "cross-env NEXT_PUBLIC_DEPLOY_MODE=desktop PARCEL_WATCHER_BACKEND=poll WATCHPACK_POLLING=true next build",
    "build:desktop:server": "node electron/copy-standalone.mjs",
    "build:desktop:main": "node electron/build.mjs",
    "build:desktop": "npm run build:desktop:next && npm run build:desktop:server && npm run build:desktop:main && electron-builder",
    "dev:desktop": "cross-env NEXT_PUBLIC_DEPLOY_MODE=desktop DESKTOP_DEV_URL=http://127.0.0.1:3000 concurrently -k -n web,app \"next dev --turbopack --port 3000\" \"node electron/build.mjs && electron .\"",
    "start:desktop": "electron ."
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "jose": "^6.0.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "esmock": "^2.7.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
